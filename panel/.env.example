# Copy to .env.local and adjust. Used ONLY by the Vite dev-server proxy
# (vite.config.ts) — none of these values reach the client bundle.
#
# The camera's BusyBox httpd sends no CORS headers, so the browser cannot
# talk to it cross-origin from localhost. The dev server proxies
# /cgi-bin and /record to CAM_HOST and injects basic auth when
# CAM_USER/CAM_PASS are set. In production the panel is served by the
# camera itself, same-origin, and no proxy is involved.
CAM_HOST=192.168.10.211
CAM_USER=
CAM_PASS=
