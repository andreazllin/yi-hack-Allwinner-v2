#!/bin/bash
# Build the frontend and stage it, pre-gzipped, for installation into the image.
#
# BusyBox httpd serves foo.js.gz transparently when a client asks for foo.js
# with Accept-Encoding: gzip, but it does not compress on the fly — so
# gzipping here is what turns a ~1 MB bundle into ~300 kB on the wire. This is
# the same thing upstream's compile.www does to its own assets.
#
# Set SKIP_FRONTEND=1 to build a firmware image without the frontend.

SCRIPT_DIR=$(cd `dirname $0` && pwd)
cd $SCRIPT_DIR

set -e

FRONTEND_SRC="$SCRIPT_DIR/../../frontend"

if [ "${SKIP_FRONTEND:-0}" = "1" ]; then
    echo "SKIP_FRONTEND=1 - building an image without the frontend."
    # The install step still relocates the stock UI to /panel/, which would
    # leave the root with no index.html at all. Skipping means skipping both.
    echo "SKIP_FRONTEND=1" > ./_skip
    mkdir -p ./_install/www
    exit 0
fi

# A prebuilt dist is used as-is; this keeps the firmware build usable on a
# machine with no Node toolchain (build the frontend elsewhere, commit nothing,
# copy dist/ in).
if [ ! -d "$FRONTEND_SRC/dist" ]; then
    # Upstream's build workflow installs no Node toolchain, and this fork does
    # not edit upstream files, so pnpm has to be found from here. corepack
    # ships with Node and reads "packageManager" out of frontend/package.json,
    # so it runs the same pnpm version the frontend CI pins.
    if command -v pnpm >/dev/null 2>&1; then
        PNPM="pnpm"
    elif command -v corepack >/dev/null 2>&1; then
        # Without this corepack asks before downloading pnpm, and a build has
        # nobody to answer.
        export COREPACK_ENABLE_DOWNLOAD_PROMPT=0
        PNPM="corepack pnpm"
    else
        echo "ERROR: neither pnpm nor corepack found, and $FRONTEND_SRC/dist"
        echo "does not exist. The frontend is the reason this fork exists, so"
        echo "refusing to ship an image silently missing it. Either install"
        echo "Node or pnpm, or prebuild frontend/dist elsewhere, or pass"
        echo "SKIP_FRONTEND=1 deliberately."
        exit 1
    fi
    echo "Building the frontend..."
    ( cd "$FRONTEND_SRC" && $PNPM install --frozen-lockfile && $PNPM build )
fi

# Straight into www/: the frontend is the camera's default UI now. The
# install step relocates the stock UI to www/panel/ first, so the only file
# these two contend for is index.html, and this module runs last.
mkdir -p ./_install/www
rsync -a "$FRONTEND_SRC/dist/" ./_install/www/

echo "Applying GZIP compression to the frontend..."
find ./_install/www -type f ! -name '*.gz' -exec gzip -f -9 {} +

echo "Frontend staged."
