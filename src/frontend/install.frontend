#!/bin/bash
# Install the staged frontend into the firmware tree at www/frontend/, which becomes
# /tmp/sd/yi-hack/www/frontend/ on the camera and is served at /frontend/.
# The stock UI stays at / — it is the fallback when a frontend build misbehaves.

SCRIPT_DIR=$(cd `dirname $0` && pwd)
cd $SCRIPT_DIR

mkdir -p ../../build/yi-hack/

rsync -a ./_install/* ../../build/yi-hack/
