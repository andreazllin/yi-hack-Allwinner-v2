#!/bin/bash
# Build the panel and stage it, pre-gzipped, for installation into the image.
#
# BusyBox httpd serves foo.js.gz transparently when a client asks for foo.js
# with Accept-Encoding: gzip, but it does not compress on the fly — so
# gzipping here is what turns a ~1 MB bundle into ~300 kB on the wire. This is
# the same thing upstream's compile.www does to its own assets.
#
# Set SKIP_PANEL=1 to build a firmware image without the panel.

SCRIPT_DIR=$(cd `dirname $0` && pwd)
cd $SCRIPT_DIR

set -e

PANEL_SRC="$SCRIPT_DIR/../../panel"

if [ "${SKIP_PANEL:-0}" = "1" ]; then
    echo "SKIP_PANEL=1 - building an image without the panel."
    mkdir -p ./_install/www/panel
    exit 0
fi

# A prebuilt dist is used as-is; this keeps the firmware build usable on a
# machine with no Node toolchain (build the panel elsewhere, commit nothing,
# copy dist/ in).
if [ ! -d "$PANEL_SRC/dist" ]; then
    if ! command -v pnpm >/dev/null 2>&1; then
        echo "ERROR: pnpm not found and $PANEL_SRC/dist does not exist."
        echo "The panel is the reason this fork exists, so refusing to ship an"
        echo "image silently missing it. Either install pnpm, or prebuild"
        echo "panel/dist elsewhere, or pass SKIP_PANEL=1 deliberately."
        exit 1
    fi
    echo "Building the panel..."
    ( cd "$PANEL_SRC" && pnpm install --frozen-lockfile && pnpm build )
fi

mkdir -p ./_install/www/panel
rsync -a "$PANEL_SRC/dist/" ./_install/www/panel/

echo "Applying GZIP compression to the panel..."
find ./_install/www/panel -type f ! -name '*.gz' -exec gzip -f -9 {} +

echo "Panel staged."
