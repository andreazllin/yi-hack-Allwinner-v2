#!/bin/bash
# Install the staged panel into the firmware tree at www/panel/, which becomes
# /tmp/sd/yi-hack/www/panel/ on the camera and is served at /panel/.
# The stock UI stays at / — it is the fallback when a panel build misbehaves.

SCRIPT_DIR=$(cd `dirname $0` && pwd)
cd $SCRIPT_DIR

mkdir -p ../../build/yi-hack/

rsync -a ./_install/* ../../build/yi-hack/
