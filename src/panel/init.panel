#!/bin/bash
# Build module that bakes the panel frontend into the firmware image.
#
# scripts/compile.sh loops over every directory in src/* and runs
# init.<name>, compile.<name>, install.<name> inside it. That loop is generic,
# so this module is picked up automatically and NO upstream file is modified —
# the fork stays additive and rebasing stays a no-op.

SCRIPT_DIR=$(cd `dirname $0` && pwd)
cd $SCRIPT_DIR

rm -rf ./_install
